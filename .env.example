# Copy to .env and fill in. NEVER commit the real .env file.
# 32-byte AES key, urlsafe-base64:  python -c "from intelliguard.security.crypto import DataCipher as D; print(D.encode_key(D.generate_key()))"
INTELLIGUARD_DATA_KEY=
# >= 32 random characters:  python -c "import secrets; print(secrets.token_urlsafe(48))"
INTELLIGUARD_JWT_SECRET=
